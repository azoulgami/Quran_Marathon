<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quran Marathon Tracker</title>
    <link rel="stylesheet" href="/styles/index.css">
</head>
<body>
    <header>
        <div class="header-top">
            <a href="/" class="logo-link"><img src="/images/logo.png" alt="Quran Marathon Logo" class="logo"></a>
            <h1>Quran Marathon Tracker</h1>
            <div class="user-info">
                <% if (user) { %>
                    <span class="welcome">Welcome, <%= user.fullName %></span>
                    <a href="/logout" class="logout-btn">Logout</a>
                <% } else { %>
                    <a href="/login" class="login-btn">Login</a>
                    <a href="/register" class="register-btn">Register</a>
                <% } %>
            </div>
        </div>
        <p class="subtitle">Track student progress & rankings</p>
    </header>

    <div class="container">
        <section class="hadith-section">
            <div class="hadith-card">
                <p class="hadith-text">"The best among you are those who learn the Quran and teach it."</p>
                <p class="hadith-source">- Sahih al-Bukhari</p>
            </div>
        </section>

        <div class="supervisor-banner">
            <p class="subtitle-ar">المشرفة: المعلمة بثينة</p>
        </div>

        <main>
            <section class="classes-section">
                <h2>Classes</h2>
                <div class="classes-grid">
                    <% classes.forEach(cls => { %>
                        <a href="/class/<%= cls.id %>" class="class-card">
                            <div class="class-header">
                                <h3><%= cls.name %></h3>
                                <span class="student-count"><%= cls.studentCount %> students</span>
                            </div>
                            <div class="class-body">
                                <p><%= cls.totalPages %>/604 Pages</p>
                                <div class="progress-bar-container">
                                    <div class="progress-bar" style="width: <%= (cls.totalPages / 604 * 100).toFixed(1) %>%"></div>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                </div>
            </section>

            <section class="add-student-section">
                <h2>Add Your Pages</h2>
                <% if (user) { %>
                    <form onsubmit="handleAddEntry(event)">
                        <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                            <div style="flex: 1;">
                                <label for="fromPage" style="display: block; margin-bottom: 5px;">From Page:</label>
                                <input type="number" id="fromPage" name="fromPage" placeholder="e.g., 1" min="1" max="604" required>
                            </div>
                            <div style="flex: 1;">
                                <label for="toPage" style="display: block; margin-bottom: 5px;">To Page:</label>
                                <input type="number" id="toPage" name="toPage" placeholder="e.g., 10" min="1" max="604" required>
                            </div>
                        </div>
                        <input type="text" placeholder="Surah (e.g., Al-Fatiha)" id="surahInput" required>
                        <button type="submit" class="btn btn-primary">Add Pages</button>
                        <small style="display:block; margin-top: 5px; color: #666;">The system will calculate how many pages you read</small>
                    </form>
                <% } else { %>
                    <div class="login-prompt">
                        <p>You must be logged in to add your pages.</p>
                        <div class="button-group">
                            <a href="/login" class="btn btn-primary">Login</a>
                            <a href="/register" class="btn btn-secondary">Create Account</a>
                        </div>
                    </div>
                <% } %>
            </section>

            <section class="leaderboard-section">
                <h2>🏆 Global Leaderboard</h2>
                <div class="leaderboard-table">
                    <% if (globalLeaderboard && globalLeaderboard.length > 0) { %>
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Student Name</th>
                                    <th>Pages</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% globalLeaderboard.forEach((student, index) => { %>
                                    <tr>
                                        <td class="rank">
                                            <% if (index === 0) { %>
                                                🥇
                                            <% } else if (index === 1) { %>
                                                🥈
                                            <% } else if (index === 2) { %>
                                                🥉
                                            <% } else { %>
                                                <%= index + 1 %>
                                            <% } %>
                                        </td>
                                        <td><%= student.full_name %></td>
                                        <td class="pages"><strong><span id="pagesDisplay<%= student.id %>"><%= formatPages(student.pages_read) %></span>/604</strong></td>
                                        <td>
                                            <div class="progress">
                                                <div class="progress-bar">
                                                    <div class="progress-fill" style="width: <%= (student.pages_read / 604) * 100 %>%"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <p style="text-align: center; padding: 20px; color: #666;">No students yet. Be the first to register!</p>
                    <% } %>
                </div>
            </section>
        </main>
    </div>

    <script>
        // Format decimal pages as fractions (0.5 -> "1/2", 1.5 -> "1 1/2", etc.)
        function formatPages(pages) {
            if (pages === null || pages === undefined) return "0";
            const num = parseFloat(pages);
            const whole = Math.floor(num);
            const decimal = num - whole;
            
            if (decimal === 0.5) {
                return whole === 0 ? "1/2" : whole + " 1/2";
            }
            return whole.toString();
        }
        function handleAddEntry(event) {
            event.preventDefault();
            const fromPage = parseFloat(document.getElementById('fromPage').value);
            const toPage = parseFloat(document.getElementById('toPage').value);
            const surah = document.getElementById('surahInput').value;
            
            if (toPage <= fromPage) {
                showNotification('❌ "To Page" must be greater than "From Page"', 'error');
                return;
            }
            
            const pagesRead = toPage - fromPage;
            
            fetch('/api/entries', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    pages: pagesRead,
                    surah: surah,
                    fromPage: fromPage,
                    toPage: toPage
                })
            }).then(res => res.json()).then(data => {
                if (data.success) {
                    document.getElementById('fromPage').value = '';
                    document.getElementById('toPage').value = '';
                    document.getElementById('surahInput').value = '';
                    showNotification(`✅ ${pagesRead} pages added successfully!`, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification('❌ Error: ' + data.message, 'error');
                }
            }).catch(err => {
                console.error('Error:', err);
                showNotification('❌ Something went wrong', 'error');
            });
        }

        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 25px;
                border-radius: 8px;
                font-weight: 600;
                z-index: 10000;
                animation: slideIn 0.3s ease-in-out;
                ${type === 'success' ? 'background: #4caf50; color: white;' : 'background: #f44336; color: white;'}
            `;
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => notification.remove(), 3000);
        }

        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideIn {
                from { transform: translateX(400px); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        `;
        document.head.appendChild(style);
    </script></body>
</html>
