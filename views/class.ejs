<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= className %> - Quran Marathon</title>
    <link rel="stylesheet" href="/styles/index.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="header-top">
                <a href="/" class="back-btn">← Back to Classes</a>
                <h1><%= className %></h1>
                <div class="user-info">
                    <% if (user) { %>
                        <span class="welcome">Welcome, <%= user.fullName %></span>
                        <a href="/logout" class="logout-btn">Logout</a>
                    <% } else { %>
                        <a href="/login" class="login-btn">Login</a>
                        <a href="/register" class="register-btn">Register</a>
                    <% } %>
                </div>
            </div>
        </header>

        <main>
            <section class="rankings-section">
                <h2>Student Rankings</h2>
                <% if(students.length === 0) { %>
                    <p class="no-data">No students yet. Add one below!</p>
                <% } else { %>
                    <div class="rankings-table">
                        <div class="table-header">
                            <div class="rank">Rank</div>
                            <div class="name">Student Name</div>
                            <div class="progress">Progress</div>
                            <div class="pages">Pages</div>
                        </div>
                        <% students.forEach((student, index) => { %>
                            <div class="table-row">
                                <div class="rank">
                                    <% if(index === 0) { %>
                                        🥇
                                    <% } else if(index === 1) { %>
                                        🥈
                                    <% } else if(index === 2) { %>
                                        🥉
                                    <% } else { %>
                                        <%= index + 1 %>
                                    <% } %>
                                </div>
                                <div class="name"><%= student.full_name %></div>
                                <div class="progress">
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: <%= (student.pages_read / 604) * 100 %>%"></div>
                                    </div>
                                </div>
                                <div class="pages"><%= student.pages_read %>/604</div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </section>
        </main>
    </div>

</body>
</html>
