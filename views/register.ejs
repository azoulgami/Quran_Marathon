<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Quran Marathon</title>
    <link rel="stylesheet" href="/styles/auth.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-box">
            <h1>📖 Quran Marathon</h1>
            <h2>Create Account</h2>
            
            <% if (message) { %>
                <div class="error"><%= message %></div>
            <% } %>

            <form method="POST" action="/register">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="your@email.com" required>
                </div>

                <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <input type="text" id="fullName" name="fullName" placeholder="Your Name" required>
                </div>

                <div class="form-group">
                    <label for="role">Are you a Teacher or Student?</label>
                    <select id="role" name="role" required onchange="toggleClassSelection()">
                        <option value="">Choose role...</option>
                        <option value="teacher">Teacher</option>
                        <option value="student">Student</option>
                    </select>
                </div>

                <div class="form-group" id="classGroup">
                    <label for="classId">Select Your Class</label>
                    <select id="classId" name="classId" required>
                        <option value="">Choose your class...</option>
                        <option value="1">Saida</option>
                        <option value="2">Nabila</option>
                        <option value="3">Aziza</option>
                        <option value="4">Faiza</option>
                        <option value="5">Shahd</option>
                        <option value="6">Soussen</option>
                        <option value="7">Amira</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>
                </div>

                <button type="submit" class="btn btn-primary">Create Account</button>
            </form>

            <p class="auth-link">
                Already have an account? <a href="/login">Login here</a>
            </p>
        </div>
    </div>

    <script>
        function toggleClassSelection() {
            const role = document.getElementById('role').value;
            const classGroup = document.getElementById('classGroup');
            const classSelect = document.getElementById('classId');
            
            if (role === 'teacher') {
                classGroup.style.display = 'none';
                classSelect.removeAttribute('required');
                // Default to first class for teacher
                classSelect.value = '1';
            } else if (role === 'student') {
                classGroup.style.display = 'block';
                classSelect.setAttribute('required', 'required');
            } else {
                classGroup.style.display = 'block';
                classSelect.removeAttribute('required');
            }
        }
        
        // Initialize on page load
        window.addEventListener('DOMContentLoaded', toggleClassSelection);
    </script>
</body>
</html>
